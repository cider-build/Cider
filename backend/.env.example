CIDER_DATABASE_PATH=./cider.db
CIDER_PORT=8000
CIDER_ALLOWED_ORIGIN=http://localhost:5173
CIDER_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CIDER_R2_BUCKET=cider-snapshots
CIDER_R2_ACCESS_KEY_ID=
CIDER_R2_SECRET_ACCESS_KEY=
CIDER_WARM_SANDBOXES_PER_NODE=2
CIDER_SANDBOX_CREATE_WAIT_SECONDS=120
CIDER_SANDBOX_TTL_SECONDS=300
CIDER_TURNSTILE_SECRET_KEY=
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
