{
  "name": "@cider/backend",
  "version": "1.0.0",
  "description": "Cider Effect backend",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm --prefix .. run lint:backend",
    "format": "biome format --write src",
    "check": "npm run typecheck && npm run lint",
    "migrate": "node --env-file=.env dist/database/migrate.js",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "clean": "rimraf dist",
    "migrate:dev": "tsx --env-file=.env src/database/migrate.ts"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/sql-sqlite-node": "4.0.0-rc.109",
    "better-auth": "1.6.29",
    "effect": "4.0.0-rc.109",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@effect/tsgo": "0.36.5",
    "@types/node": "22.20.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
